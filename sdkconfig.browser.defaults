CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_RTTI=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
# Ordinary malloc/new prefer PSRAM even for small math nodes. RTOS/DMA
# allocations retain explicit internal-memory capabilities and the 64 KiB reserve.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# File paths throughout InkPy and MicroPython are UTF-8, not DOS codepage bytes.
CONFIG_FATFS_API_ENCODING_UTF_8=y
# CONFIG_FATFS_API_ENCODING_ANSI_OEM is not set
